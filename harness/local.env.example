# This machine's harness paths. Copy to harness/local.env (git-ignored) and set the ones that differ from the main
# PC's E: defaults; leave a line out to keep its default. The environment always wins over this file.
# Paths only: any other name, VICTORY_ALLOW_OBS included, is ignored with a warning (harness/local-env.mjs).
# Forward slashes work everywhere; quote a value with spaces or not, either way.

# The title's executable inside the dump (the folder victory.toml's game_dir names).
GAME_EXE=<drive>/path/to/dump/game.exe

# Each run's capture folder is made as <VICTORY_CAPTURES>/<stamp>-<tag>. Outside every repo.
VICTORY_CAPTURES=<drive>/victory-captures

# Snapshot builds (snapshot-build.sh), and the victory checkout --list reads commit subjects from.
VICTORY_BUILDS=<drive>/victory-builds
VICTORY_REPO=<drive>/path/to/this repository/victory

# The lane worktrees run-queue.sh looks a bare lane name up in.
VICTORY_WORKTREES=<drive>/path/to/this repository/worktrees

# PresentMon 2.6's executable.
PRESENTMON_EXE=<drive>/path/to/PresentMon-2.6.0-x64.exe

# Save snapshots (<root>/snapshots) and the backups taken before each --save restore (<root>/before-runs).
VICTORY_SAVE_BACKUPS=<home>/victory-save-backups
